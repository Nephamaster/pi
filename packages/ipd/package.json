{
	"name": "@earendil-works/pi-ipd",
	"version": "0.85.1",
	"description": "IPD workflow IR, asset registries, and compiler for pi",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"assets",
		"examples",
		"prompts",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "vitest --run"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "^0.85.1",
		"@earendil-works/pi-ai": "^0.85.1",
		"@earendil-works/pi-coding-agent": "^0.85.1",
		"typebox": "1.3.7",
		"yaml": "2.9.0"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"shx": "0.4.0",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	},
	"engines": {
		"node": ">=24"
	}
}
